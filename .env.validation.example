# Add to each deployment's api.env. Configure a different private secret per environment.
VALIDATION_SEED_ENABLED=true
VALIDATION_SEED_PROFILE=uat
VALIDATION_SEED_SECRET=
VALIDATION_CREDENTIALS_PATH=/app/data/validation-credentials.md
# Production: set VALIDATION_SEED_PROFILE=prod and a separate 32+ character secret.
# Keep the secret unchanged between deployments; existing passwords are never reset.
