# Backend-only; never use NEXT_PUBLIC_ for Zoom secrets.
APP_ENV=development
ZOOM_PROVIDER_MODE=mock
# Generate a stable key with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ZOOM_TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/integrations/zoom/callback
# For live use: APP_ENV=production, ZOOM_PROVIDER_MODE=live, HTTPS redirect, real app credentials and secret token.
# Keep the encryption key stable across deploys. Changing it requires an explicit token migration/reconnect.
