# Configure these on the API server, never in NEXT_PUBLIC variables or chat.
# Use test keys first. The Razorpay.me handle is not an API Key ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SAAS_RAZORPAY_WEBHOOK_SECRET=

# Confirmed customer pricing: base + 18% GST, no customer processing surcharge.
# Razorpay's processing fee/GST are merchant settlement costs.
SAAS_GST_BPS=1800
SAAS_PLATFORM_FEE_BPS=0
SAAS_PLATFORM_FEE_PAISE=0
SAAS_GST_ON_PLATFORM_FEE=false

# Enable only after configured test payments, webhook delivery and route checks.
# Legacy subscriptions stay unmanaged; rollout needs explicit account review.
SAAS_ACCESS_ENFORCEMENT_ENABLED=false

# Razorpay webhook URL: https://YOUR_API_HOST/api/v1/saas-billing/webhooks/razorpay
# Subscribe to payment.captured. The existing student-payment webhook is separate.
# Configure automatic capture in Razorpay; authorized-only payments do not unlock.
